# Normaliza fim de linha: o repositório guarda LF; cada SO converte o que for texto genérico
* text=auto

# Arquivos que rodam dentro de containers Linux: sempre LF, inclusive no Windows
*.sh        text eol=lf
*.txt       text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env.example text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# Binários
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
